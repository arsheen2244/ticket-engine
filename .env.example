# Copy this file to .env and change the values. `docker compose` reads .env automatically.
# Never commit .env: it is git-ignored. Every value here is a placeholder.

# ---- Login tokens ----
# HMAC key that signs login tokens, at least 32 characters. Generate one with:  openssl rand -hex 32
# Empty = a random key on every start (fine for a quick local try; logins end when the app restarts).
JWT_SECRET=
JWT_TTL_MINUTES=60
# true when the site is served over HTTPS (production), so the login cookie is HTTPS-only.
COOKIE_SECURE=false

# ---- First admin account (created or promoted at startup; sign-up only makes USER accounts) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-pass

# ---- Original benchmark API ----
# true keeps POST /api/events/{id}/reserve and friends open for k6 and the demo page at :8080/.
# Set false on a public deployment.
LEGACY_ENDPOINTS=true
# Shared secret for the original create/reset endpoints (X-Admin-Token header). Empty = open (dev only).
ADMIN_TOKEN=

# ---- Only needed when running the backend outside Docker (mvn spring-boot:run) ----
# DB_URL=jdbc:postgresql://localhost:5432/tickets
# DB_USER=tickets
# DB_PASSWORD=tickets
# REDIS_URL=redis://localhost:6379
# KAFKA_BOOTSTRAP=localhost:9092
# TICKET_ASYNC=false
